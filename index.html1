<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>غيوم | Ghiom</title>
<meta name="description" content="متجر غيوم: منتجات وهدايا فاخرة بتفاصيل مصنوعة بدقة وتغليف يليق بالمناسبة.">
<meta name="color-scheme" content="dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&family=Tajawal:wght@400;500&display=swap">
<style>
:root{--bg:#0a0f26;--bg2:#141a45;--bg3:#070a1b;--gold:#f0b35c;--gold2:#f7d094;--ivory:#e9ebf8;--mute:#aab0d6;--lav:#cdd2f8;--line:rgba(160,170,240,.28);
--safe-t:env(safe-area-inset-top,0px);--safe-b:env(safe-area-inset-bottom,0px);color-scheme:dark;box-sizing:border-box;padding-top:var(--safe-t);padding-bottom:var(--safe-b)}
html{scroll-behavior:smooth;scroll-padding-top:72px;height:100%}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ivory);font-family:'Tajawal','Cairo',Tahoma,sans-serif;font-size:17px;line-height:1.8}
h1,h2,h3{font-family:'Cairo',Tahoma,sans-serif;margin:0;line-height:1.35;color:var(--lav)}
h1{font-size:clamp(2.1rem,6vw,3.7rem);font-weight:800}
h2{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;margin-bottom:.6rem}
h3{font-size:1.15rem}
p{margin:0 0 1rem}
a{color:inherit}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
section{padding:72px 0}
:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font:600 1rem 'Cairo',sans-serif;padding:13px 28px;border-radius:999px;border:1.5px solid var(--gold);cursor:pointer;text-decoration:none;transition:background .2s,color .2s,transform .15s;min-height:48px}
.btn:active{transform:scale(.97)}
.btn-gold{background:var(--gold);color:#1a1405}.btn-gold:hover{background:var(--gold2)}
.btn-line{background:transparent;color:var(--gold2)}.btn-line:hover{background:rgba(201,162,75,.14)}
.btn-wa{background:#1f6b4a;border-color:#2f8c63;color:#fff}.btn-wa:hover{background:#25805a}
/* header */
header{position:sticky;top:var(--safe-t);z-index:20;background:rgba(7,10,27,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:var(--safe-t);background:rgba(7,10,27,.88);backdrop-filter:blur(10px);z-index:30}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:'Cairo';font-weight:800;font-size:1.4rem;color:var(--gold2);text-decoration:none;display:flex;align-items:baseline;gap:.5rem}
.logo small{font-size:.7rem;letter-spacing:.25em;color:var(--mute);font-weight:400}
.nav nav{display:flex;gap:22px;font-size:.95rem}
.nav nav a{text-decoration:none;color:var(--ivory);opacity:.85}.nav nav a:hover{color:var(--gold2);opacity:1}
@media(max-width:760px){.nav nav{display:none}}
/* hero */
.hero{padding:56px 0 80px;background:radial-gradient(60% 50% at 18% 8%,rgba(125,110,215,.38),transparent 70%),radial-gradient(70% 60% at 88% 0%,rgba(80,135,200,.32),transparent 70%),radial-gradient(60% 40% at 50% 105%,rgba(240,179,92,.22),transparent 70%),radial-gradient(1.5px 1.5px at 20px 30px,#fff,transparent),radial-gradient(1px 1px at 95px 85px,#cfd4ff,transparent),var(--bg);background-size:auto,auto,auto,150px 130px,210px 180px,auto}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero p.lead{color:var(--mute);font-size:1.15rem;max-width:34em;margin:1.2rem 0 2rem}
.cta-row{display:flex;gap:14px;flex-wrap:wrap}
.arch{aspect-ratio:1;border-radius:50%;border:1.5px solid var(--lav);padding:12px;background:linear-gradient(160deg,#2a3380,#0b1030);box-shadow:0 0 70px rgba(150,140,240,.4),0 0 0 9px rgba(160,170,240,.1);position:relative}
.arch .ph,.slide .ph{width:100%;height:100%;border-radius:50%;display:grid;place-items:center;text-align:center;color:var(--gold);background:repeating-linear-gradient(135deg,rgba(201,162,75,.07) 0 14px,transparent 14px 28px);font-family:'Cairo';padding:20px;overflow:hidden}
.arch .ph img{border-radius:50%}.ph img,.slide img{width:100%;height:100%;object-fit:cover;display:block}
.ph b{display:block;font-size:2.6rem;letter-spacing:.2em;color:var(--gold2)}
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr}.arch{max-width:340px;margin:0 auto;order:-1}}
/* features */
.feat{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:36px}
.card{background:var(--bg2);border:1px solid var(--line);border-radius:18px;padding:26px 22px}
.card svg{width:34px;height:34px;stroke:var(--gold);fill:none;stroke-width:1.6;margin-bottom:12px}
.card p{color:var(--mute);margin:.4rem 0 0;font-size:.97rem}
@media(max-width:900px){.feat{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.feat{grid-template-columns:1fr}}
/* product */
#product{background:var(--bg3)}
.prod{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start;margin-top:30px}
.gallery{position:relative}
.track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:20px;border:1px solid var(--line);scrollbar-width:none}
.track::-webkit-scrollbar{display:none}
.slide{flex:0 0 100%;scroll-snap-align:center;aspect-ratio:1/1;padding:10px;background:var(--bg2)}
.slide .ph{border-radius:12px}
.gnav{display:flex;gap:10px;justify-content:center;margin-top:14px}
.gnav button{width:44px;height:44px;border-radius:50%;border:1px solid var(--gold);background:transparent;color:var(--gold2);font-size:1.2rem;cursor:pointer}
.dots{display:flex;gap:8px;align-items:center}.dots i{width:8px;height:8px;border-radius:50%;background:var(--line)}.dots i.on{background:var(--gold2)}
.price{display:flex;align-items:baseline;gap:14px;margin:14px 0 6px;font-family:'Cairo'}
.price .now{font-size:2rem;font-weight:800;color:var(--gold2)}.price .old{color:var(--mute);text-decoration:line-through}
.opts{margin:18px 0}.opts label{display:block;font-family:'Cairo';font-weight:600;margin-bottom:6px}
.chips{display:flex;gap:10px;flex-wrap:wrap}
.chips button{font:500 .95rem 'Cairo';padding:8px 18px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--ivory);cursor:pointer}
.chips button[aria-pressed=true]{background:var(--gold);color:#1a1405;border-color:var(--gold)}
@media(max-width:820px){.prod{grid-template-columns:1fr}}
/* craft */
.craft{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:minmax(150px,auto);gap:16px;margin-top:34px}
.tile{border-radius:20px;border:1px solid var(--line);padding:26px;display:flex;flex-direction:column;justify-content:flex-end;background:var(--bg2);position:relative;overflow:hidden}
.tile:nth-child(1){grid-column:span 4;grid-row:span 2;background:linear-gradient(150deg,#323b8f,#0e1336);min-height:300px}
.tile:nth-child(2){grid-column:span 2}
.tile:nth-child(3){grid-column:span 2;background:var(--gold);color:#1a1405}.tile:nth-child(3) h3{color:#1a1405}
.tile:nth-child(4){grid-column:span 6;flex-direction:row;align-items:center;gap:20px;justify-content:space-between}
.tile p{margin:.3rem 0 0;color:var(--mute);font-size:.97rem}.tile:nth-child(3) p{color:#3a2d0c}
.tile .big{position:absolute;top:10px;inset-inline-start:22px;font:800 6rem/1 'Cairo';color:rgba(201,162,75,.15)}
@media(max-width:700px){.craft{grid-template-columns:1fr}.tile:nth-child(n){grid-column:auto;grid-row:auto;min-height:0}.tile:nth-child(4){flex-direction:column;align-items:flex-start}}
/* why */
.why{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;align-items:start}
.why ul{list-style:none;margin:0;padding:0}
.why li{padding:18px 0;border-bottom:1px solid var(--line)}.why li:first-child{padding-top:0}
.why li b{font-family:'Cairo';color:var(--gold2);font-size:1.1rem}.why li span{display:block;color:var(--mute)}
@media(max-width:820px){.why{grid-template-columns:1fr;gap:20px}}
/* reviews */
.revs{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:30px}
.stars{color:var(--gold2);letter-spacing:3px}
.empty{border:1.5px dashed var(--line);border-radius:18px;padding:34px;text-align:center;color:var(--mute);grid-column:1/-1}
/* faq */
details{border-bottom:1px solid var(--line);padding:4px 0}
summary{cursor:pointer;font:600 1.08rem 'Cairo';padding:16px 0;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--gold2);font-size:1.5rem;transition:transform .25s}
details[open] summary::after{transform:rotate(45deg)}
details p{color:var(--mute);padding-bottom:12px;max-width:46em}
.faq{max-width:780px}
/* final */
.final{text-align:center;background:linear-gradient(180deg,var(--bg3),#262c6b 65%,#6b4a7c);border-block:1px solid var(--line);padding:84px 0}
.final p{color:var(--mute);max-width:34em;margin:0 auto 1.8rem}
/* footer */
footer{background:var(--bg3);padding:48px 0 110px;color:var(--mute);font-size:.95rem}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:30px}
footer h3{font-size:1rem;margin-bottom:10px}footer a{display:block;text-decoration:none;padding:3px 0}footer a:hover{color:var(--gold2)}
.copy{border-top:1px solid var(--line);margin-top:30px;padding-top:18px;font-size:.88rem}
@media(max-width:700px){.fgrid{grid-template-columns:1fr}}
/* sticky buy bar */
.bar{position:fixed;inset-inline:0;bottom:0;z-index:25;background:rgba(7,10,27,.95);border-top:1px solid var(--gold);padding:10px 16px calc(10px + var(--safe-b));display:none;gap:10px}
.bar .btn{flex:1;padding:11px 10px}
@media(max-width:760px){.bar{display:flex}}
/* modal */
.modal{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;padding:16px}
.modal.open{display:flex}
.sheet{background:var(--bg2);border:1px solid var(--gold);border-radius:22px;width:100%;max-width:520px;max-height:92vh;overflow:auto;padding:26px;animation:up .28s ease}
@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
.sheet .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.x{background:none;border:0;color:var(--ivory);font-size:1.8rem;cursor:pointer;width:44px;height:44px}
.f{margin-bottom:12px}.f label{display:block;font:600 .92rem 'Cairo';margin-bottom:4px}
.f input,.f textarea,.f select{width:100%;font:inherit;color:var(--ivory);background:var(--bg3);border:1px solid var(--line);border-radius:12px;padding:11px 14px}
.f input:focus,.f textarea:focus{border-color:var(--gold2);outline:none}
.r2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.err{color:#ff9d8a;font-size:.85rem;min-height:1.2em}
.ok{text-align:center;padding:10px 0}.ok .code{display:inline-block;margin:10px 0;padding:6px 18px;border:1px dashed var(--gold);border-radius:10px;font:800 1.2rem 'Cairo';color:var(--gold2);direction:ltr}
.note{font-size:.88rem;color:var(--mute)}
/* loading bar */
.lbar{position:fixed;top:0;left:0;width:0;height:3px;background:var(--gold);z-index:100;transition:width .3s ease;border-radius:0 2px 2px 0}
.lbar.run{width:75%;transition:width 2s ease}
.lbar.done{width:100%;transition:width .2s ease}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}

.dash{position:fixed;inset:0;z-index:60;background:var(--bg3);display:none;overflow:auto;padding:calc(16px + var(--safe-t)) 16px calc(40px + var(--safe-b))}
.dash.open{display:block}.dwrap{max-width:860px;margin:0 auto}
.dhead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.dtabs{overflow-x:auto;flex-wrap:nowrap;margin-bottom:20px;padding-bottom:4px}.dtabs button{white-space:nowrap}
.ord{background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:10px;font-size:.95rem;line-height:1.7}
.orow{display:flex;gap:10px;align-items:center;margin-top:8px}.orow select{width:auto;flex:1}
.oh{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.thumbs{display:flex;gap:12px;flex-wrap:wrap;margin:8px 0 14px}.thumbs div{position:relative;width:84px;height:84px}
.thumbs img{width:100%;height:100%;object-fit:cover;border-radius:10px;border:1px solid var(--line)}
.thumbs .x{position:absolute;top:-10px;inset-inline-start:-10px;width:28px;height:28px;border-radius:50%;background:var(--gold);color:#1a1405;font-size:1.1rem;line-height:1}
.dsel{width:100%;font:inherit;color:var(--ivory);background:var(--bg3);border:1px solid var(--line);border-radius:12px;padding:8px 12px}
</style>
</head>
<body>
<div id="lbar" class="lbar"></div><header><div class="wrap nav">
  <a class="logo" href="#top">غيوم <small>GHIOM</small></a>
  <nav><a href="#features">المميزات</a><a href="#product">المنتج</a><a href="#craft">التفاصيل</a><a href="#reviews">الآراء</a><a href="#faq">الأسئلة</a></nav>
  <button class="btn btn-gold" style="padding:8px 20px;min-height:44px" data-order>اطلب الآن</button>
</div></header>

<main id="top">
<section class="hero"><div class="wrap">
  <div>
    <h1>حيث يلتقي الخيال</h1>
    <p class="lead">متجرك المفضل لكل ما تحتاجه.. جودة مميزة وتوصيل سريع.</p>
    <div class="cta-row">
      <a class="btn btn-gold" href="#product">اكتشف منتجاتنا</a>
      <button class="btn btn-line" data-order>اطلب الآن</button>
    </div>
  </div>
  <div class="arch"><div class="ph" id="heroImg"><div><b>GHIOM</b><span>ضع صورة المنتج الرئيسية هنا</span></div></div></div>
</div></section>

<section id="features"><div class="wrap">
  <h2>لماذا يطمئن عملاؤنا</h2>
  <div class="feat">
    <div class="card"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg><h3>ضمان الرضا</h3><p>إن لم يطابق طلبك ما اتفقنا عليه، نصحّحه معك.</p></div>
    <div class="card"><svg viewBox="0 0 24 24"><path d="M3 7l9-4 9 4-9 4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/></svg><h3>شحن آمن وتغليف بعناية</h3><p>كل قطعة تُغلَّف بمواد تحميها حتى تصلك سليمة.</p></div>
    <div class="card"><svg viewBox="0 0 24 24"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg><h3>جودة تصنيع عالية</h3><p>خامات مختارة وتشطيب يُفحص قبل التسليم.</p></div>
    <div class="card"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/></svg><h3>متابعة الطلب</h3><p>نرد على استفساراتك ونوافيك بحالة طلبك خطوة بخطوة.</p></div>
  </div>
</div></section>

<section id="product"><div class="wrap">
  <h2>المنتج الرئيسي</h2>
  <div class="prod">
    <div class="gallery">
      <div class="track" id="track" tabindex="0" aria-label="معرض صور المنتج"></div>
      <div class="gnav"><button id="nx" aria-label="التالي">‹</button><div class="dots" id="dots" style="margin:0 8px"></div><button id="pv" aria-label="السابق">›</button></div>
    </div>
    <div>
      <h2 id="pName" style="font-size:1.9rem"></h2>
      <p id="pDesc" style="color:var(--mute)"></p>
      <div class="price" id="priceBox"></div>
      <div class="opts" id="opts"></div>
      <div class="cta-row">
        <button class="btn btn-gold" data-order>اشترِ الآن</button>
        <a class="btn btn-wa" id="waAsk" href="#" target="_blank" rel="noopener">استفسر عبر واتساب</a>
      </div>
    </div>
  </div>
</div></section>

<section id="craft"><div class="wrap">
  <h2>تفاصيل تصنع بدقة</h2>
  <p style="color:var(--mute);max-width:36em">ما يميز القطعة الفاخرة لا يظهر من بعيد؛ يظهر حين تقترب منها.</p>
  <div class="craft">
    <div class="tile"><span class="big">أ</span><h3>دقة الطباعة</h3><p>ألوان ثابتة وحواف حادة، تُراجَع على نموذج تجريبي قبل الطباعة النهائية.</p></div>
    <div class="tile"><h3>جودة الخامات</h3><p>ورق وأقمشة وأسطح نختارها لتدوم وتبدو أغلى.</p></div>
    <div class="tile"><h3>اللمسات الذهبية</h3><p>تفاصيل ذهبية تضيف بريقًا هادئًا.</p></div>
    <div class="tile"><div><h3>جودة التغليف</h3><p>علبة وحشوة وشريط، كل ذلك جزء من الهدية وليس إضافة عليها.</p></div><button class="btn btn-line" data-order>اطلب قطعتك</button></div>
  </div>
</div></section>

<section style="background:var(--bg3)"><div class="wrap why">
  <div><h2>لماذا تختار غيوم؟</h2><p style="color:var(--mute)">نبني كل طلب كأنه الوحيد، ونقيس نجاحنا بابتسامة من يفتح الهدية.</p></div>
  <ul>
    <li><b>جودة لا نساوم عليها</b><span>نرفض أي قطعة لا تطابق معيارنا، حتى لو تأخر التسليم قليلًا.</span></li>
    <li><b>تجربة شراء بسيطة</b><span>نموذج قصير، ثم نؤكد معك التفاصيل عبر واتساب.</span></li>
    <li><b>اهتمام بالتفاصيل الصغيرة</b><span>من اختيار اللون إلى طريقة طي الغلاف.</span></li>
  </ul>
</div></section>

<section id="reviews"><div class="wrap">
  <h2>آراء العملاء</h2>
  <div class="revs" id="revs"></div>
</div></section>

<section id="faq"><div class="wrap faq">
  <h2>الأسئلة الشائعة</h2>
  <div id="faqList"></div>
</div></section>

<section class="final"><div class="wrap">
  <h2>هديتك القادمة تستحق تفاصيل أفضل</h2>
  <p>أرسل طلبك الآن، ونتواصل معك لتأكيد كل تفصيلة قبل التنفيذ.</p>
  <button class="btn btn-gold" data-order style="font-size:1.1rem;padding:15px 40px">اطلب منتجك الآن</button>
</div></section>
</main>

<footer><div class="wrap">
  <div class="fgrid">
    <div><a class="logo" href="#top" style="display:inline-flex">غيوم <small>GHIOM</small></a><p style="margin-top:10px">متجر للمنتجات والهدايا الفاخرة.</p></div>
    <div><h3>الأقسام</h3><a href="#features">المميزات</a><a href="#product">المنتج</a><a href="#reviews">آراء العملاء</a><a href="#faq">الأسئلة الشائعة</a></div>
    <div><h3>تواصل معنا</h3><span id="fWa"></span><div id="fSocial"></div><a href="#faq">سياسة الاستبدال والاسترجاع</a></div>
  </div>
  <div class="copy"><a href="#dashboard" id="adminLink" style="display:none">لوحة التحكم</a> © <span id="yr"></span> متجر غيوم. جميع الحقوق محفوظة.</div>
</div></footer>

<div class="bar"><button class="btn btn-gold" data-order>اشترِ الآن</button><a class="btn btn-wa" id="waBar" href="#" target="_blank" rel="noopener">واتساب</a></div>

<div class="dash" id="dash"><div class="dwrap">
<div class="dhead"><h2 style="margin:0">لوحة تحكم غيوم</h2><a class="btn btn-line" href="#top">عرض المتجر</a></div>
<div class="chips dtabs" id="dtab"><button data-t="orders">الطلبات</button><button data-t="product">المنتج والأسعار</button><button data-t="contact">التواصل</button><button data-t="faq">الأسئلة الشائعة</button><button data-t="reviews">آراء العملاء</button></div>
<div id="dbody"></div><div class="err" id="dmsg" role="status" style="margin-top:12px"></div>
</div></div>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mt">
  <div class="sheet">
    <div class="top"><h3 id="mt" style="font-size:1.4rem">أكمل طلبك</h3><button class="x" id="close" aria-label="إغلاق">×</button></div>
    <form id="form" novalidate>
      <div class="f"><label for="n">الاسم الكامل</label><input id="n" autocomplete="name" required></div>
      <div class="r2">
        <div class="f"><label for="ph">رقم الهاتف</label><input id="ph" type="tel" inputmode="tel" autocomplete="tel" required></div>
        <div class="f"><label for="ct">المدينة</label><input id="ct" autocomplete="address-level2" required></div>
      </div>
      <div class="f"><label for="ad">المنطقة والعنوان</label><input id="ad" autocomplete="street-address" required></div>
      <div class="r2">
        <div class="f"><label for="pr">المنتج المطلوب</label><input id="pr" readonly></div>
        <div class="f"><label for="qt">الكمية</label><input id="qt" type="number" min="1" max="99" value="1" inputmode="numeric"></div>
      </div>
      <div class="f"><label for="nt">ملاحظات إضافية (اختياري)</label><textarea id="nt" rows="2"></textarea></div>
      <div class="err" id="err" role="alert"></div>
      <button class="btn btn-gold" type="submit" style="width:100%">أرسل الطلب</button>
    </form>
    <div class="ok" id="ok" hidden>
      <h3 style="font-size:1.4rem">تم تجهيز طلبك</h3>
      <div class="code" id="code"></div>
      <p id="okMsg"></p>
      <a class="btn btn-wa" id="okWa" href="#" target="_blank" rel="noopener" hidden>أرسل الطلب عبر واتساب</a>
      <button class="btn btn-line" id="copyBtn" type="button" hidden>انسخ تفاصيل الطلب</button>
    </div>
  </div>
</div>

<script type="application/json" id="cfgdata">{}</script>
<script>
const DEF={whatsapp:"",social:[],heroImage:"",reviews:[],
 product:{name:"اسم المنتج",desc:"أضف وصف المنتج من لوحة التحكم: الخامات والمقاسات وما يتضمنه الطلب.",price:"",oldPrice:"",images:[],options:[]},
 faq:[["كيف يمكنني تقديم طلب؟","اضغط «اشترِ الآن»، املأ النموذج القصير، وسنؤكد التفاصيل معك عبر واتساب أو الهاتف."],["ما هي مدة التوصيل؟","تُحدَّد المدة حسب مدينتك ونوع المنتج، ونخبرك بها عند تأكيد الطلب."],["هل يتوفر الدفع عند الاستلام؟","نوضح لك طرق الدفع المتاحة لمدينتك عند تأكيد الطلب."],["هل يمكن تخصيص المنتج؟","نعم، اكتب ما تريد تخصيصه في خانة الملاحظات وسنراجعه معك قبل التنفيذ."],["كيف يمكنني التواصل مع خدمة العملاء؟","عبر زر واتساب في الموقع، وسنرد عليك في أقرب وقت."],["ما سياسة الاستبدال والاسترجاع؟","إذا وصلك منتج به عيب تصنيع أو يخالف المتفق عليه، تواصل معنا وسنعالج الأمر."]]};
let CFG=JSON.parse(JSON.stringify(DEF));
try{const o=JSON.parse(document.getElementById('cfgdata').textContent||'{}');CFG={...DEF,...o,product:{...DEF.product,...(o.product||{})}}}catch(_){}
let db=null,art=null,assets=null,dl=null,admin=false,orders=[],tab='orders';
const $=s=>document.querySelector(s);
const esc=t=>String(t==null?'':t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const waUrl=txt=>CFG.whatsapp?`https://wa.me/${CFG.whatsapp}?text=${encodeURIComponent(txt)}`:'';
const chosen={};
function render(){
 const P=CFG.product;$('#yr').textContent=new Date().getFullYear();
 if(CFG.heroImage)$('#heroImg').innerHTML=`<img src="${esc(CFG.heroImage)}" alt="غيوم">`;
 $('#pName').textContent=P.name;$('#pDesc').textContent=P.desc;
 $('#priceBox').innerHTML=P.price?`<span class="now">${esc(P.price)}</span>${P.oldPrice?`<span class="old">${esc(P.oldPrice)}</span>`:''}`:`<span class="now" style="font-size:1.3rem">السعر عند الطلب</span>`;
 const imgs=P.images.length?P.images:[null,null,null],tr=$('#track');
 tr.innerHTML=imgs.map((u,i)=>`<div class="slide">${u?`<img src="${esc(u)}" alt="${esc(P.name)} ${i+1}" loading="lazy">`:`<div class="ph"><div><b>${i+1}</b>مكان صورة المنتج</div></div>`}</div>`).join('');
 $('#dots').innerHTML=imgs.map(()=>'<i></i>').join('');
 let gIdx=0;const dots=()=>document.querySelectorAll('#dots i').forEach((d,i)=>d.classList.toggle('on',i===gIdx));
 const goTo=i=>{gIdx=Math.max(0,Math.min(imgs.length-1,i));const s=tr.children[gIdx];if(s)s.scrollIntoView({behavior:'smooth',block:'nearest',inline:'nearest'});dots()};
 tr.onscroll=()=>{const cw=tr.clientWidth;if(cw>0){const raw=tr.scrollLeft,abs=Math.abs(raw);const i=Math.round((raw>=0?raw:abs)/cw);if(i!==gIdx){gIdx=i;dots()}}};
 $('#nx').onclick=()=>goTo(gIdx+1);$('#pv').onclick=()=>goTo(gIdx-1);dots();
 Object.keys(chosen).forEach(k=>delete chosen[k]);
 $('#opts').innerHTML=P.options.map((o,oi)=>`<label>${esc(o.label)}</label><div class="chips" style="margin-bottom:12px">${o.values.map((v,vi)=>`<button type="button" data-o="${oi}" data-v="${esc(v)}" aria-pressed="${vi===0}">${esc(v)}</button>`).join('')}</div>`).join('');
 P.options.forEach(o=>chosen[o.label]=o.values[0]);
 $('#opts').onclick=e=>{const b=e.target.closest('button');if(!b)return;chosen[P.options[b.dataset.o].label]=b.dataset.v;b.parentNode.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b))};
 $('#revs').innerHTML=CFG.reviews.length?CFG.reviews.map(r=>`<div class="card"><div class="stars" aria-label="${r.stars} من 5">${'★'.repeat(r.stars)}${'☆'.repeat(5-r.stars)}</div><p style="margin:.5rem 0">${esc(r.text)}</p><b style="font-family:Cairo;color:var(--gold2)">${esc(r.name)}</b></div>`).join(''):`<div class="empty">لا توجد آراء منشورة بعد. ستظهر هنا تقييمات عملائنا الحقيقيين فور إضافتها.</div>`;
 $('#faqList').innerHTML=CFG.faq.map(q=>`<details><summary>${esc(q[0])}</summary><p>${esc(q[1])}</p></details>`).join('');
 const ask=waUrl(`مرحبًا، أودّ الاستفسار عن: ${P.name}`);
 ['#waAsk','#waBar'].forEach(x=>{const a=$(x);a.href=ask||'#';a.onclick=ask?null:e=>{e.preventDefault();alert('لم يُضبط رقم واتساب بعد.')}});
 $('#fWa').innerHTML=CFG.whatsapp?`<a href="${ask}" target="_blank" rel="noopener" dir="ltr" style="text-align:right">+${esc(CFG.whatsapp)}</a>`:'<span>رقم واتساب: يُضاف قريبًا</span>';
 $('#fSocial').innerHTML=CFG.social.map(x=>`<a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.name)}</a>`).join('');
}
render();
/* رابط Google Apps Script: الصقه هنا بين علامتي الاقتباس */
const SHEET_URL="https://script.google.com/macros/s/AKfycbzHi-dPSDU091ffnqgYEV7dmUDU2nY8blevFuEloLkFDtXg0yLgsgePeMSAGWB48wmN1Q/exec";
if(SHEET_URL){const lb=document.getElementById('lbar');if(lb)lb.className='lbar run';fetch(SHEET_URL).then(r=>r.json()).then(o=>{CFG={...CFG,...o,product:{...CFG.product,...(o.product||{})}};render()}).catch(()=>{}).finally(()=>{if(lb){lb.className='lbar done';setTimeout(()=>{lb.style.opacity='0'},400)}})}
/* order modal */
const modal=$('#modal'),form=$('#form');let lastFocus,summary='';
function openM(){lastFocus=document.activeElement;const P=CFG.product,ch=Object.entries(chosen);$('#pr').value=P.name+(ch.length?' ('+ch.map(([k,v])=>k+': '+v).join('، ')+')':'');form.hidden=false;$('#ok').hidden=true;$('#err').textContent='';modal.classList.add('open');setTimeout(()=>$('#n').focus(),50)}
function closeM(){modal.classList.remove('open');lastFocus&&lastFocus.focus()}
document.addEventListener('click',e=>{if(e.target.closest('[data-order]'))openM()});
$('#close').onclick=closeM;modal.addEventListener('click',e=>{if(e.target===modal)closeM()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))closeM()});
form.addEventListener('submit',async e=>{
 e.preventDefault();const v=id=>$('#'+id).value.trim();
 if(!v('n')||!v('ct')||!v('ad')){$('#err').textContent='أكمل الاسم والمدينة والعنوان.';return}
 if(!/^[+\d][\d\s\-()]{5,}$/.test(v('ph'))){$('#err').textContent='أدخل رقم هاتف صحيحًا (أرقام فقط).';return}
 const q=Math.max(1,parseInt(v('qt'))||1),code='GH-'+Date.now().toString(36).toUpperCase().slice(-6);
 summary=`طلب جديد ${code}\nالاسم: ${v('n')}\nالهاتف: ${v('ph')}\nالمدينة: ${v('ct')}\nالعنوان: ${v('ad')}\nالمنتج: ${v('pr')}\nالكمية: ${q}`+(v('nt')?`\nملاحظات: ${v('nt')}`:'');
 let saved=false;
 if(SHEET_URL){try{await fetch(SHEET_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify({code,name:v('n'),phone:v('ph'),city:v('ct'),address:v('ad'),product:v('pr'),qty:q,notes:v('nt')})});saved=true}catch(_){}}
 if(db){try{await db.doc('orders/'+code).set({code,name:v('n'),phone:v('ph'),city:v('ct'),address:v('ad'),product:v('pr'),qty:q,notes:v('nt'),status:'جديد',createdAt:Date.now()});saved=true}catch(_){}}
 $('#code').textContent=code;form.hidden=true;$('#ok').hidden=false;
 const link=waUrl(summary);$('#okWa').hidden=!link;$('#copyBtn').hidden=!!(link||saved);if(link)$('#okWa').href=link;
 $('#okMsg').textContent=link?(saved?'سُجّل طلبك. أرسله عبر واتساب لتسريع التأكيد.':'اضغط الزر لإرسال تفاصيل الطلب إلى واتساب المتجر. لا يكتمل الطلب قبل إرسالها.'):saved?'تم تسجيل طلبك، وسيتواصل معك المتجر لتأكيده.':'لم يُرسل الطلب لأي جهة بعد. انسخ التفاصيل وأرسلها للمتجر.';
});
$('#copyBtn').onclick=async()=>{try{await navigator.clipboard.writeText(summary);$('#copyBtn').textContent='تم النسخ'}catch(_){$('#copyBtn').textContent='تعذّر النسخ'}};
/* dashboard */
const D=$('#dash'),dbody=$('#dbody'),ST=['جديد','قيد التجهيز','تم الشحن','مكتمل','ملغي'];
const msg=(t,bad)=>{const m=$('#dmsg');m.textContent=t;m.style.color=bad?'':'var(--gold2)'};
const fld=(id,l,v,r)=>`<div class="f"><label for="${id}">${l}</label>${r?`<textarea id="${id}" rows="${r}">${esc(v)}</textarea>`:`<input id="${id}" value="${esc(v)}">`}</div>`;
const SV='<button class="btn btn-gold" id="sv">حفظ ونشر التغييرات</button>';
const T={
 orders(){dbody.innerHTML=(db?'':'<p class="note">سجّل الدخول في claude.ai لعرض الطلبات المحفوظة.</p>')+`<div class="oh"><b>${orders.length} طلب</b><button class="btn btn-line" id="csv">تصدير CSV</button></div>`+(orders.length?orders.map(o=>`<div class="ord"><div><b>${esc(o.code)}</b>، ${esc(o.name)}، <a href="tel:${esc(o.phone)}" dir="ltr">${esc(o.phone)}</a></div><div>${esc(o.city)} — ${esc(o.address)}</div><div>${esc(o.product)} × ${esc(o.qty)}${o.notes?' — '+esc(o.notes):''}</div><div class="note">${new Date(o.createdAt).toLocaleString('ar')}</div><div class="orow"><select class="dsel" data-s="${esc(o.id)}">${ST.map(x=>`<option${x===o.status?' selected':''}>${x}</option>`).join('')}</select><button class="x" data-d="${esc(o.id)}" aria-label="حذف الطلب">🗑</button></div></div>`).join(''):'<div class="empty">لا توجد طلبات محفوظة بعد. الطلبات القادمة من زوار غير مسجلين تصلك عبر واتساب فقط.</div>')},
 product(){const P=CFG.product;dbody.innerHTML=fld('pn','اسم المنتج',P.name)+fld('pd','الوصف',P.desc,4)+`<div class="r2">${fld('pp','السعر (مع العملة)',P.price)}${fld('po','السعر قبل الخصم',P.oldPrice)}</div>`+fld('pop','الخيارات: سطر لكل خيار، مثال: اللون: أخضر، أسود',P.options.map(o=>o.label+': '+o.values.join('، ')).join('\n'),3)+`<div class="f"><label>صور المنتج</label><div class="thumbs">${P.images.map((u,i)=>`<div><img src="${esc(u)}" alt=""><button class="x" data-ri="${i}" aria-label="حذف الصورة">×</button></div>`).join('')}</div>${assets?`<input type="file" id="up" accept="image/*"><p class="note">صورة الواجهة الرئيسية:</p><input type="file" id="uh" accept="image/*">`:'<p class="note">رفع الصور غير متاح الآن.</p>'}</div>`+SV},
 contact(){dbody.innerHTML=fld('wa','رقم واتساب (بالصيغة الدولية، أرقام فقط)',CFG.whatsapp)+fld('so','حسابات التواصل: سطر لكل حساب، مثال: انستغرام | https://...',CFG.social.map(x=>x.name+' | '+x.url).join('\n'),4)+SV},
 faq(){dbody.innerHTML=fld('fq','سطر لكل سؤال: السؤال | الجواب',CFG.faq.map(q=>q[0]+' | '+q[1]).join('\n'),12)+SV},
 reviews(){dbody.innerHTML='<p class="note">أضف آراء عملاء حقيقيين فقط. السطر: الاسم | عدد النجوم | التعليق</p>'+fld('rv','',CFG.reviews.map(r=>r.name+' | '+r.stars+' | '+r.text).join('\n'),10)+SV}
};
function refresh(){if(!D.classList.contains('open'))return;
 if(!admin){dbody.innerHTML='<p>هذه اللوحة للمالك فقط. افتح الرابط من حسابك على claude.ai.</p>';return}
 document.querySelectorAll('#dtab button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.t===tab));T[tab]()}
function route(){const on=location.hash==='#dashboard';D.classList.toggle('open',on);document.body.style.overflow=on?'hidden':'';if(on){msg('');refresh()}}
function collect(){const g=id=>{const x=$('#'+id);return x?x.value.trim():null},L=id=>(g(id)||'').split('\n').map(x=>x.trim()).filter(Boolean),P=CFG.product;
 if(tab==='product'){P.name=g('pn')||P.name;P.desc=g('pd');P.price=g('pp');P.oldPrice=g('po');P.options=L('pop').map(l=>{const[a,b]=l.split(':');return{label:a.trim(),values:(b||'').split(/[،,]/).map(x=>x.trim()).filter(Boolean)}}).filter(o=>o.values.length)}
 if(tab==='contact'){CFG.whatsapp=(g('wa')||'').replace(/\D/g,'');CFG.social=L('so').map(l=>{const[a,...b]=l.split('|');return{name:a.trim(),url:b.join('|').trim()}}).filter(x=>/^https?:\/\//.test(x.url))}
 if(tab==='faq')CFG.faq=L('fq').map(l=>{const[a,...b]=l.split('|');return[a.trim(),b.join('|').trim()]}).filter(q=>q[1]);
 if(tab==='reviews')CFG.reviews=L('rv').map(l=>{const p=l.split('|');return{name:p[0].trim(),stars:Math.min(5,Math.max(1,parseInt(p[1])||5)),text:p.slice(2).join('|').trim()}}).filter(r=>r.text)}
function buildHtml(){const o={...CFG};if(o.heroImage===DEF.heroImage)delete o.heroImage;const c=document.documentElement.cloneNode(true);
 c.querySelector('#cfgdata').textContent=JSON.stringify(o).replace(/</g,'\\u003c');
 ['#dash','#modal'].forEach(x=>c.querySelector(x).classList.remove('open'));c.querySelector('#dbody').innerHTML='';c.querySelector('#adminLink').style.display='none';c.querySelector('body').removeAttribute('style');
 return '<!DOCTYPE html>\n'+c.outerHTML}
async function save(){if(!art){msg('النشر غير متاح لهذا الحساب.',1);return}
 try{msg('جارٍ النشر...');await art.publish(buildHtml())}catch(e){msg(e&&e.code==='conflict'?'تغيّرت الصفحة أثناء الحفظ. أعد المحاولة.':'تعذّر النشر.',1)}}
$('#dtab').onclick=e=>{const b=e.target.closest('button');if(!b)return;collect();tab=b.dataset.t;msg('');refresh()};
dbody.onclick=async e=>{const t=e.target.closest('button');if(!t)return;
 if(t.id==='sv'){collect();await save()}
 else if(t.dataset.ri!==undefined){collect();CFG.product.images.splice(+t.dataset.ri,1);await save()}
 else if(t.dataset.d){if(confirm('حذف هذا الطلب نهائيًا؟'))try{await db.doc('orders/'+t.dataset.d).delete()}catch(_){msg('تعذّر الحذف.',1)}}
 else if(t.id==='csv'){const rows=[['الرقم','الاسم','الهاتف','المدينة','العنوان','المنتج','الكمية','ملاحظات','الحالة']].concat(orders.map(o=>[o.code,o.name,o.phone,o.city,o.address,o.product,o.qty,o.notes,o.status]));
  const csv='\ufeff'+rows.map(r=>r.map(c=>'"'+String(c==null?'':c).replace(/"/g,'""')+'"').join(',')).join('\n');
  if(dl)try{await dl.save({filename:'ghiom-orders.csv',data:csv})}catch(_){}else msg('التصدير غير متاح الآن.',1)}};
dbody.onchange=async e=>{const t=e.target;
 if(t.dataset.s){try{await db.doc('orders/'+t.dataset.s).update({status:t.value})}catch(_){msg('تعذّر تحديث الحالة.',1)}}
 else if(t.id==='up'||t.id==='uh'){const f=t.files[0];if(!f)return;collect();
  try{msg('جارٍ رفع الصورة...');const r=await assets.upload(f);if(t.id==='up')CFG.product.images.push(r.url);else CFG.heroImage=r.url;await save()}catch(_){msg('تعذّر رفع الصورة. تأكد من صيغتها وحجمها.',1)}}};
window.addEventListener('hashchange',route);route();
(async()=>{const C=window.claude;if(!C||!C.use)return;
 try{const u=await C.use('user');admin=u?await u.canEdit():false}catch(_){}
 try{db=await C.use('db')}catch(_){}
 if(admin){try{art=await C.use('artifact')}catch(_){}try{assets=await C.use('assets')}catch(_){}try{dl=await C.use('downloads')}catch(_){}
  $('#adminLink').style.display='inline';
  if(db)try{db.collection('orders').orderBy('createdAt','desc').limit(300).onSnapshot(sn=>{orders=sn.docs.map(d=>({id:d.id,...d.data()}));if(tab==='orders')refresh()},()=>{})}catch(_){}}
 refresh()})();
</script>
</body>
</html>
